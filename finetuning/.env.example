# finetuning/ configuration. Read by finetuning/libs.py from the SAME root .env as convert/.
#
# DATA_ROOT, OUT_DIR, DATASET_NAME, SCENE, RIG_HEIGHT_CM, RIG_PITCH_DEG must already be set
# there and must match whatever built the dataset you're pointing at — pose.<tag>/goal.<tag>
# won't resolve otherwise.

VAL_FRACTION=0.1
SEED=0
NUM_WORKERS=4
DEVICE=cuda
# CHECKPOINT_ROOT=/path/to/checkpoints

# =============================================================================
# System 2 — Cosmos3-Edge Reasoner Tower fine-tuned as a text-based pixel-goal VLM.
# Replaces InternVLA-N1's Qwen2.5-VL System 2 for the "where should I go" half only; System 1
# below is a separate lightweight controller, not InternVLA-N1's diffusion trajectory policy.
# =============================================================================
COSMOS3_EDGE_CHECKPOINT=nvidia/Cosmos3-Edge
SYSTEM2_DTYPE=bfloat16

# {instruction} is filled in at train and inference time from meta/tasks.jsonl.
SYSTEM2_PROMPT_TEMPLATE=You are an autonomous navigation assistant. Your task is to {instruction}. Where should you go next to stay on track? Please output the next waypoint's coordinates in the image.
# {u},{v} filled in from the goal.<tag> parquet column. Keep in sync with parse_pixel_goal in
# system2_infer.py if you change the order or separators here.
SYSTEM2_TARGET_TEMPLATE={u},{v}

# --- Multi-task mix ----------------------------------------------------------
# Tasks trained together in one LoRA run; names must be keys of system2_train.TASK_SPECS
# (pixel_goal, action, detect). Set SYSTEM2_TASKS=pixel_goal for the original single-task run.
# "detect" (object-pointing + scene understanding, trained against the literal deployed
# Cosmos3Reasoner.detect_landmarks() prompt) needs a SCENE_DIR built by convert_habitat/, not
# convert/ — a real-recording dataset has no detect/ rows, so add it only for Habitat-sourced
# data, e.g. SYSTEM2_TASKS=pixel_goal,action,detect
SYSTEM2_TASKS=pixel_goal,action
# One weight per task, as a sampling SHARE (already normalized by each task's own frame count).
# Leave empty for an equal share each.
SYSTEM2_TASK_WEIGHTS=
# Action task: the goal pixel is given, the model names the action. {instruction}, {u}, {v}.
SYSTEM2_ACTION_PROMPT_TEMPLATE=You are an autonomous navigation assistant. Your task is to {instruction}. The next waypoint is at pixel {u},{v} in the image. Which single action should you take now? Answer with exactly one of: STOP, FORWARD, LEFT, RIGHT.
SYSTEM2_ACTION_TARGET_TEMPLATE={action}
# Order is load-bearing — must match data.py's STOP/FORWARD/LEFT/RIGHT = 0/1/2/3.
SYSTEM2_ACTION_NAMES=STOP,FORWARD,LEFT,RIGHT

SYSTEM2_LORA_R=16
SYSTEM2_LORA_ALPHA=32
SYSTEM2_LORA_DROPOUT=0.05
# A regex over full module names, not a substring list — verified against the real checkpoint:
# the vision encoder also has q_proj/k_proj/v_proj (only out_proj differs from the text
# decoder's o_proj), so a substring list would silently also LoRA-wrap the vision encoder.
SYSTEM2_LORA_TARGET_MODULES=^model\.language_model\.layers\.\d+\.self_attn\.(q_proj|k_proj|v_proj|o_proj)$

SYSTEM2_LEARNING_RATE=1e-4
SYSTEM2_WEIGHT_DECAY=0.01
SYSTEM2_NUM_EPOCHS=5
SYSTEM2_BATCH_SIZE=4
# Effective batch size = this, since the DataLoader itself runs at batch_size=1 (see
# system2_train.build_collate_fn — variable per-image vision-token counts make naive batching
# unsafe without confirming the processor's own padding behavior first).
SYSTEM2_GRAD_ACCUM_STEPS=8
SYSTEM2_WARMUP_RATIO=0.03
SYSTEM2_MAX_GRAD_NORM=1.0
SYSTEM2_MAX_NEW_TOKENS=16

SYSTEM2_LOG_EVERY_N_STEPS=20
SYSTEM2_EVAL_EVERY_N_EPOCHS=1
SYSTEM2_RUN_NAME=system2_cosmos_lora

# =============================================================================
# System 1 — small discrete-action controller: (rgb frame, predicted pixel goal) -> action.
# Trained from scratch on this dataset's own action labels; independent of System 2's weights.
# =============================================================================
SYSTEM1_IMAGE_SIZE=224
SYSTEM1_BACKBONE=resnet18
SYSTEM1_IMAGE_EMBED_DIM=512
SYSTEM1_GOAL_EMBED_DIM=64
SYSTEM1_HIDDEN_DIM=256
SYSTEM1_N_ACTIONS=4

SYSTEM1_LEARNING_RATE=3e-4
SYSTEM1_WEIGHT_DECAY=1e-4
SYSTEM1_NUM_EPOCHS=30
SYSTEM1_BATCH_SIZE=64

SYSTEM1_LOG_EVERY_N_STEPS=50
SYSTEM1_EVAL_EVERY_N_EPOCHS=1
SYSTEM1_RUN_NAME=system1_controller
