# convert_habitat/ pipeline configuration. Read by convert_habitat/libs.py from the SAME
# root .env as convert/ and finetuning/. Every key here is HABITAT_-prefixed (except the
# shared OUT_DIR, reused as-is) so nothing collides with convert/'s or finetuning/'s keys.

# =============================================================================================
# Where the data lives
# =============================================================================================
# Shared with convert/ — the two pipelines' datasets live in different sub-paths under this
# same root (see HABITAT_DATASET_NAME below), never colliding.
# OUT_DIR=/home/longht16/longht/data/office/recorded/traj_data

HABITAT_R2R_DATA_ROOT=data/vln_ce/raw_data/r2r
HABITAT_SCENES_DIR=data/scene_data/

# Which R2R split to build: train / val_seen / val_unseen.
HABITAT_SPLIT=train

# Optional restriction, for smoke tests — comma list of MP3D scan ids, and/or an episode cap:
#   HABITAT_SCENES=17DRP5sb8fy
#   HABITAT_LIMIT_EPISODES=5
# HABITAT_SCENES=
# HABITAT_LIMIT_EPISODES=

HABITAT_DATASET_NAME=habitat_r2r
# episode_index = task_index * this + repeat_index. 1 = one deterministic oracle rollout per
# R2R episode, no augmentation.
HABITAT_REPEATS_PER_EPISODE=1
HABITAT_SEED=0

# =============================================================================================
# Camera geometry — matches habitat-lab's benchmark/nav/vln_r2r.yaml resolved sensor config
# (rgb_sensor.position=[0,1.25,0], orientation=[0,0,0] — verified directly, not invented):
# the sensor sits 1.25m above the floor, perfectly level. Deliberately a DIFFERENT tag than
# whatever RIG_HEIGHT_CM/RIG_PITCH_DEG resolve to for the real-recording dataset in the root
# .env, so the two datasets' pose.<tag>/goal.<tag> columns can never collide.
# =============================================================================================
HABITAT_RIG_HEIGHT_CM=125
HABITAT_RIG_PITCH_DEG=0

# =============================================================================================
# Sensor render resolution — rendered natively at this size and hfov, no crop/resize step
# (unlike convert/, which only crops because a physical ZED camera has a fixed native res).
# =============================================================================================
HABITAT_OUT_W=640
HABITAT_OUT_H=480
HABITAT_HFOV=90
HABITAT_JPEG_QUALITY=90
HABITAT_MAX_DEPTH_M=10.0

# =============================================================================================
# Task D — keyframe / subgoal selection. NOT the same numbers as convert/'s MIN_MOVE=0.25 /
# MIN_TURN_DEG=10 on purpose: Habitat's own atomic forward step is already 0.25m, so those
# defaults would keep every single sim step and defeat the downsampling.
# =============================================================================================
HABITAT_MIN_MOVE=0.5
HABITAT_MIN_TURN_DEG=30.0
HABITAT_SUBGOAL_DIST=2.5
HABITAT_MAX_GOAL_FRAMES=20
HABITAT_MIN_FRAMES=4

# =============================================================================================
# Rollout / ShortestPathFollower
# =============================================================================================
HABITAT_GOAL_RADIUS_LEG=0.25
HABITAT_GOAL_RADIUS_FINAL=1.0
HABITAT_SNAP_TOLERANCE_M=1.0
HABITAT_MAX_STEPS_PER_LEG=200
HABITAT_MAX_EPISODE_STEPS=500

# =============================================================================================
# Task B/C — object-pointing + scene understanding
# =============================================================================================
HABITAT_MIN_INSTANCE_PIXELS=100
# Coarse guard against MP3D's mesh-reconstruction artifacts around mirrors/glass (verified:
# an implausible ~11% frame-filling instance turned out to be a mirror-reflection artifact).
HABITAT_MAX_INSTANCE_FRACTION=0.08
HABITAT_EXCLUDE_CATEGORIES=wall,ceiling,floor,misc,void,unlabeled,objects,railing,column,beam,board_panel
HABITAT_N_POSITIVES=3
HABITAT_N_NEGATIVES=3
HABITAT_N_CANDIDATES_MAX=6
HABITAT_GUESS_MAX_LOOKAHEAD=15
