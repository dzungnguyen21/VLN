# convert/ pipeline configuration. Read by convert/libs.py at import.
# A real environment variable overrides anything here:
#     TARGET_FPS=3 python convert/main.py build

# =============================================================================
# THE CAMERA MOUNT — MEASURE THIS. There is no sane default.
#
# These bags carry no /tf, so height and pitch cannot be recovered from the data. Every goal
# label is a floor point projected through them, and that label is where the model is told to
# walk. A wrong value builds cleanly, passes every check, and trains wrong.
#   5 deg of pitch error  moves the goal pixel 31 px (6% of frame height)
#   20 cm of height error moves it 22 px (5%)
# The height is used twice: it also turns auto-scale's "height in trajectory units" into
# metres per unit.
# =============================================================================
RIG_HEIGHT_CM=90
RIG_PITCH_DEG=22.3

# =============================================================================
# Where the data lives
# =============================================================================
DATA_ROOT=/home/longht16/longht/data/office/recorded

# Derived from DATA_ROOT unless set explicitly:
RECORD_DIR=/home/longht16/longht/data/office/recorded/record
RESULTS_DIR=/home/longht16/longht/data/office/recorded/results
# OUT_DIR=/home/longht16/longht/data/office/recorded/traj_data

# Defaults to instruction_log.json beside this file:
# INSTRUCTION_LOG=/home/longht16/Downloads/real_data/instruction_log.json

# One scene = one ENVIRONMENT, every instruction filmed in it.
# Neither may contain 'rgb': the loader derives the depth path with .replace('rgb','depth').
DATASET_NAME=office_recording
SCENE=scene_0001

# Width of each instruction's block of episode indices:
#     episode_index = task_index * TAKES_PER_INSTRUCTION + repeat_index
# DO NOT change after the first run — it renumbers every episode above the first
# instruction, while the parquets already written stay where they are.
TAKES_PER_INSTRUCTION=5

# =============================================================================
# Stage 1 — tracking
# =============================================================================
TRACK_FPS=-1.0 

# =============================================================================
# Stage 2 — the dataset
# =============================================================================
# 640x480 is vln_ce native; centre-crops 1920x1080 to 4:3, hfov 104 deg -> ~88 deg
OUT_W=640
OUT_H=480
JPEG_QUALITY=90

# cuVSLAM tracks at 15 Hz; the dataset keeps ~2
TARGET_FPS=2.0
MIN_MOVE=0.25
MIN_TURN_DEG=10.0
TOL_MS=60.0

# Tied to TARGET_FPS. relative_goal_frame_id counts FRAMES and the loader drops k < 3. At
# 2 Hz one frame covers ~0.6 m, so 1.5 m gives k ~ 2.5 and the dataset comes out EMPTY.
# Change TARGET_FPS and this has to change with it; stage 2 warns when it is too tight.
SUBGOAL_DIST=2.5
MAX_GOAL_FRAMES=30  
MIN_FRAMES=4

# =============================================================================
# Metric scale — mono VO does not know metres
# =============================================================================
# Each recording's scale factor is independent, so one global number cannot work.
# AUTO_SCALE measures it per bag from the floor texture; SCALE_OVERRIDES always wins.
AUTO_SCALE=true
MAX_SPREAD=0.10

# Sanity band for the implied walking speed, in m/s. A human walks ~0.8-1.4.
SPEED_MIN=0.5
SPEED_MAX=2.0

# Per-bag pins, as JSON on ONE line. Use when auto-scale warns about spread.
#   {"zed_record_run_07_02": {"path_length": 24.5}}
# path_length = real metres walked; traj_scale = the factor directly.
SCALE_OVERRIDES={}
